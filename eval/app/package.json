{
  "name": "cowork-genealogy-eval-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @genealogy/schema generate && next dev --hostname 127.0.0.1",
    "build": "tsx scripts/gen-zod.ts && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "gen-zod": "tsx scripts/gen-zod.ts",
    "postinstall": "tsx scripts/gen-zod.ts"
  },
  "dependencies": {
    "@genealogy/schema": "workspace:*",
    "@mantine/core": "7.15.1",
    "@mantine/form": "7.15.1",
    "@mantine/hooks": "7.15.1",
    "@mantine/notifications": "7.15.1",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "^5.106.1",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "json-schema-to-zod": "^2.8.1",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
