{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/gate-issue-create.py\"",
            "timeout": 10,
            "statusMessage": "Checking issue-filing order"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git ls-tree *)",
      "Bash(git merge-base *)",
      "Bash(git grep *)",
      "mcp__genealogy__record_read",
      "mcp__genealogy__record_search"
    ]
  }
}
