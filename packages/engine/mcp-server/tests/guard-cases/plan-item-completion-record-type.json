{
  "guard": "plan-item-completion-record-type",
  "description": "A research_append write marking a plan item `completed` whose `record_type` has a known vocabulary (RECORD_TYPE_TERMS: probate, census, vital/vital_record, church/church_record, marriage, naturalization, obituary) when some log[] entry is attributed to it but NONE names a search of that type \u2014 the probate item closed off a deed/land search (ut_search_full_text_016/_020). Silent when an attributed entry matches the type, when nothing is attributed (the structural gate's job), when the record_type is outside the vocabulary, and for any status but completed. Replayed by planItemCompletionRecordTypeInvariants (research-append.ts), the content half of the completion check.",
  "format": "expect: fire | silent, judged for the plan item named by `write` (found in research.plans[].items). research.log holds the attributed entries. Every fire case carries a `shape`; a guard needs at least two distinct fire shapes and at least one silent case.",
  "cases": [
    {
      "id": "probate-completed-off-land-search",
      "expect": "fire",
      "shape": "probate-off-land",
      "why": "A probate plan item marked completed whose only attributed log entry is a deed/land fulltext search \u2014 no probate term in tool/notes/query.",
      "write": "pli_006",
      "research": {
        "plans": [
          {
            "id": "pl_002",
            "status": "active",
            "items": [
              {
                "id": "pli_006",
                "record_type": "probate",
                "status": "completed"
              }
            ]
          }
        ],
        "log": [
          {
            "plan_item_id": "pli_006",
            "tool": "fulltext_search",
            "notes": "1 result in Pennsylvania Land Records (collectionId 2220359), Schuylkill",
            "query": {
              "keywords": "+Thomas +Flynn",
              "recordType": "deed"
            }
          }
        ]
      }
    },
    {
      "id": "census-completed-off-marriage-search",
      "expect": "fire",
      "shape": "census-off-vital",
      "why": "A census plan item marked completed whose only attributed entry is a marriage search \u2014 no census term (census/household/dwelling/enumerat).",
      "write": "pli_010",
      "research": {
        "plans": [
          {
            "id": "pl_003",
            "status": "active",
            "items": [
