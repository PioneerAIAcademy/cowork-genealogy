        "log": [
          {
            "plan_item_id": "pli_010",
            "tool": "record_search",
            "notes": "Marriage of John Flynn to Mary Byrne, 1868",
            "query": {
              "surname": "Flynn",
              "recordType": "marriage"
            }
          }
        ]
      }
    },
