{
  "guard": "plan-item-void-search",
  "description": "A research_append write marking a plan item `completed` when every non-error `fulltext_search` attributed to it is scoped to a `query.imageGroupNumber`, every one returned nothing (`results_available === 0`), every such id is a bare digit run, FamilySearch reports NONE of them as full-text searchable, and no `image_search` entry (any outcome) names the item. Such a nil is a fact about the volume's coverage, not about the person, so the completion claims a search that could not have happened and the volume never surfaces as unread (#4431, feedback #4379). Silent on an UNKNOWN answer (`searchable: null`), on any searchable id, on a composite or mixed id set, on a non-void entry, when an image_search names the item, and for any status but completed. Replayed by planItemVoidSearchInvariants (research-append.ts).",
  "format": "expect: fire | silent, judged for the plan item named by `write` (found in research.plans[].items). research.log holds the attributed entries. `searchable` is the set FamilySearch reported, as a list; absent or null means UNKNOWN, which never fires. Every fire case carries a `shape`; a guard needs at least two distinct fire shapes and at least one silent case.",
  "cases": [
    {
      "id": "single-bare-group-unsearchable",
      "expect": "fire",
      "shape": "single-bare-group",
      "why": "One attributed scoped full-text search, void, on one bare-digit id FamilySearch does not report as searchable. The maria-vazsan-spouse 5219332 shape.",
      "write": "pli_005",
      "searchable": [],
      "research": {
        "plans": [
          {
            "id": "pl_002",
            "status": "active",
            "items": [
              {
                "id": "pli_005",
                "record_type": "church",
                "status": "completed"
              }
            ]
          }
        ],
        "log": [
          {
            "plan_item_id": "pli_005",
            "tool": "fulltext_search",
            "outcome": "negative",
            "query": {
              "imageGroupNumber": "5219332"
            },
            "results_available": 0
          }
        ]
      }
    },
    {
      "id": "multi-bare-group-all-unsearchable",
      "expect": "fire",
      "shape": "multi-bare-group",
      "why": "Several scoped void entries across several bare-digit ids, none searchable. The real corpus shape: hugh-mclachlan-marriage pli_005 carries three group ids.",
      "write": "pli_005",
      "searchable": [],
      "research": {
        "plans": [
          {
            "id": "pl_002",
            "status": "active",
            "items": [
              {
                "id": "pli_005",
                "record_type": "church",
                "status": "completed"
              }
            ]
          }
        ],
        "log": [
          {
            "plan_item_id": "pli_005",
            "tool": "fulltext_search",
            "outcome": "negative",
            "query": {
              "imageGroupNumber": "4102848"
            },
            "results_available": 0
          },
          {
            "plan_item_id": "pli_005",
            "tool": "fulltext_search",
            "outcome": "negative",
            "query": {
              "imageGroupNumber": "4102858"
            },
            "results_available": 0
          },
          {
            "plan_item_id": "pli_005",
            "tool": "fulltext_search",
            "outcome": "negative",
            "query": {
              "imageGroupNumber": "4102865"
            },
            "results_available": 0
          }
        ]
      }
    },
    {
      "id": "scoped-void-among-productive-searches",
      "expect": "fire",
      "shape": "scoped-void-among-productive",
      "why": "THE MOTIVATING CASE, from feedback bundle 2026-11-09 (pli_005, Walpole NH town records). The bundle attributes five full-text searches to the item; the four carried here are three keyword/place searches that returned thousands of rows, and one that NAMES an image group — which returned nothing and which FamilySearch does not report as searchable. The productive three never searched that volume, so the item is still unread and condition 2 reads only the entries that name a group. The id here, 1987741, is in fact a collection id rather than an image group: the refusal is correct in outcome but reached through the documented unknown-id hole, and its message sends the agent to record_search for exactly that reason.",
      "write": "pli_005",
      "searchable": [],
      "research": {
        "plans": [
          {
            "id": "pl_002",
            "status": "active",
            "items": [
              {
                "id": "pli_005",
                "record_type": "vital_record",
                "status": "completed"
              }
            ]
          }
        ],
        "log": [
          {
            "plan_item_id": "pli_005",
            "tool": "fulltext_search",
            "outcome": "partial",
            "results_available": 6316,
            "query": {
              "keywords": "+Eastman",
              "includeFacets": true
            }
          },
          {
            "plan_item_id": "pli_005",
            "tool": "fulltext_search",
            "outcome": "negative",
            "results_available": 0,
            "query": {
              "keywords": "+Eastman",
              "imageGroupNumber": "1987741"
            }
          },
          {
            "plan_item_id": "pli_005",
            "tool": "fulltext_search",
            "outcome": "partial",
            "results_available": 3376,
            "query": {
              "keywords": "+Eastman",
              "place": "Cheshire, New Hampshire"
            }
          },
          {
            "plan_item_id": "pli_005",
            "tool": "fulltext_search",
            "outcome": "partial",
            "results_available": 1156,
            "query": {
              "keywords": "+Eastman +Walpole",
              "count": 20
            }
          }
        ]
      }
    },
