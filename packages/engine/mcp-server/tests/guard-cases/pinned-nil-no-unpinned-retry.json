{
  "guard": "pinned-nil-no-unpinned-retry",
  "description": "A research_log_append record_search op that returned zero hits while pinned to a collectionId and has no unpinned retry — a sibling record_search with NO collectionId whose name fields (givenName, surname, givenNameAlt, surnameAlt, and every key ending in GivenName/Surname) equal this op's after trimming, ignoring case, and alternate-name auto-pairing, in the same batch (research.ops) or already in log[] (a sibling logged error never ran and does not count). Other filters may differ; a wildcard sibling does not clear an exact variant. Silent for a query with no name field, a non-zero-hit op, and an op with no collectionId. Keyed on zero HITS, never on outcome. Replayed by the writer-tool precondition pinnedNilRetryInvariants (research-log-append.ts).",
  "format": "expect: fire | silent, judged for the op named by `write` in research.ops (the op the preflight has already resolved — `query` is its sent query, `zeroHit` its resolved zero-hit state). research.ops are the other ops in the same batch; research.log is what earlier calls persisted. `ops[].id` is a test-fixture selector; the ResearchLogAppendOp type carries no id. Every fire case carries a `shape`; a guard needs at least two distinct fire shapes and at least one silent case.",
  "cases": [
    {
      "id": "nil-no-ref-no-retry",
      "expect": "fire",
      "shape": "nil-no-staged-ref",
      "why": "The simon-heydocker-death shape: a death search pinned to collection 1394580, logged with no staged ref and resultsExamined 0, never re-run without the collection.",
      "write": "op_a",
      "research": {
        "log": [],
        "ops": [
          {
            "id": "op_a",
            "tool": "record_search",
            "query": {
              "surname": "Heydöcker",
              "givenName": "Simon",
              "recordType": "death",
              "collectionId": "1394580"
            },
            "zeroHit": true
          }
        ]
      }
    },
    {
      "id": "staged-count-zero-no-retry",
      "expect": "fire",
      "shape": "staged-count-zero",
      "why": "Defensive branch: a staged ref whose recomputed count is 0 (a real zero-hit record_search stages nothing).",
      "write": "op_a",
      "research": {
        "log": [],
        "ops": [
          {
            "id": "op_a",
            "tool": "record_search",
            "query": {
              "surname": "Heidecker",
              "givenName": "Simon",
              "collectionId": "1520587"
            },
            "zeroHit": true
          }
        ]
      }
    },
    {
      "id": "variant-surname-sibling-only",
      "expect": "fire",
      "shape": "variant-surname-sibling-only",
      "why": "The only unpinned sibling searched a different surname variant; each variant needs its own unpinned retry (surname-only matching rejected in the issue review).",
      "write": "op_a",
      "research": {
        "log": [],
        "ops": [
          {
            "id": "op_a",
            "tool": "record_search",
            "query": {
              "surname": "Heidecker",
              "givenName": "Simon",
              "collectionId": "1394580"
            },
            "zeroHit": true
          },
          {
            "id": "op_b",
            "tool": "record_search",
            "query": {
              "surname": "Heydöcker",
              "givenName": "Simon"
            },
            "zeroHit": false
          }
        ]
      }
    },
    {
      "id": "wildcard-unpinned-sibling",
      "expect": "fire",
