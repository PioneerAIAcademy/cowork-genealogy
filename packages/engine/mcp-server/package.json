{
  "name": "genealogy-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for genealogy research",
  "main": "build/index.js",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22",
    "npm": ">=11.12 <12"
  },
  "scripts": {
    "build": "tsc && node ../../../scripts/write-build-info.mjs",
    "start": "node build/index.js",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "pretest": "npm run build && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "open": "^10.2.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@smithy/node-http-handler": "^4.12.1",
    "pg": "^8.23.0"
  }
}
