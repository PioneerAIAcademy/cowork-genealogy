{
  "description": "Raw writes to research.json / tree.gedcomx.json must go through the MCP writer tools, which validate before persisting. The matcher must stay at least as wide as guard_project_files.py's FILE_WRITE_TOOLS + DEVICE_WRITE_TOOLS -- it decides whether the script runs at all, so a tool the script would deny but the matcher omits is a hole the script can never close. `.*device_commit_files` (not the bare name) because Cowork namespaces it `mcp__remote-devices__device_commit_files` and the plugin cannot control the prefix; the leading `.*` makes it bind even if the matcher is applied as an anchored full match. Over-matching is safe -- the script is the precise filter. It also covers `.*research_append`, because the script routes ownership-restricted sections (see OWNED_SECTIONS) by caller identity; the matcher is part of that guardrail, not packaging detail.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|.*device_commit_files|.*research_append",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/guard_project_files.py",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/probe_hook_census.py PreToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/probe_hook_census.py PostToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/probe_hook_census.py SubagentStop",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/probe_hook_census.py Stop",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/probe_hook_census.py PreCompact",
            "timeout": 15
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/probe_hook_census.py PostCompact",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/probe_hook_census.py SessionStart",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
