# Hoisted node_modules layout so electron-builder / electron-vite and the
# engine's own npm tooling behave exactly as they do with plain npm.
node-linker=hoisted
shamefully-hoist=true

# Fail install when the running Node is outside the "engines" range of the
# root package.json (>=22) or of a package it installs. The test tooling sets
# the real floor: jsdom 30 needs 22.22.2+ on 22, 24.15+ on 24, or 26+ (23 and
# 25 are refused); scripts/check-node-floor.mjs says so before a reinstall
# deletes node_modules and before eval\Setup.bat installs. Without this, a
# wrong Node version only surfaces as cryptic runtime errors.
engine-strict=true
