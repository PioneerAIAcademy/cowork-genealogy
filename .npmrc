# Hoisted node_modules layout so electron-builder / electron-vite and the
# engine's own npm tooling behave exactly as they do with plain npm.
node-linker=hoisted
shamefully-hoist=true

# Fail install when the running Node is outside ANY installed package's
# "engines" range, not only the root package.json's (>=22). The test tooling
# sets the real floor: vitest 5 and jsdom 30 need 22.22.2+ on 22, 24.15+ on
# 24, or 26+. Without this, a wrong Node version only surfaces as cryptic
# runtime errors.
engine-strict=true
