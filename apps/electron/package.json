{
  "name": "@genealogy/electron",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "Pioneer Academy",
  "homepage": "https://github.com/PioneerAIAcademy/cowork-genealogy",
  "scripts": {
    "postinstall": "install-electron || echo WARNING - the Electron binary did not install, so the viewer cannot start. Retry with: pnpm --filter @genealogy/electron exec install-electron",
    "format": "prettier --write .",
    "lint": "eslint --cache . --max-warnings 0",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "pnpm --filter @genealogy/schema generate && electron-vite dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && electron-vite build",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "rebuild-native": "electron-builder install-app-deps",
    "build:unpack": "npm run clean:dist && npm run build && electron-builder --dir && npm run check-packaged",
    "build:win": "npm run clean:dist && npm run build && electron-builder --win && npm run check-packaged",
    "build:mac": "npm run clean:dist && npm run build && electron-builder --mac && npm run check-packaged",
    "build:linux": "npm run clean:dist && npm run build && electron-builder --linux && npm run check-packaged",
    "check-packaged": "node scripts/check-packaged-deps.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@genealogy/schema": "workspace:*",
    "@genealogy/viewer-ui": "workspace:*",
    "chokidar": "^5.0.0",
    "focus-trap-react": "^12.0.3",
    "jszip": "^3.10.2",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "^4.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "44.11.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
