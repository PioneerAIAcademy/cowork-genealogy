# The malachi stack's settings. `make malachi-up` copies this to
# ~/.config/genealogy-beta/env at mode 600 and fills the blank secrets once; that copy
# never enters the repo. Keep it: a new FS_TOKEN_ENC_KEY answers 401 to every user, and a
# new POSTGRES_PASSWORD is refused by an initialised database.

PUBLIC_URL=https://malachi.taild68f1b.ts.net
DATA_DIR=/home/data/genealogy-beta
MINIO_ROOT_USER=genealogy

# Comma-separated FamilySearch emails that may sign in. Blank admits nobody.
ALLOWED_EMAILS=

# Blank uses the URLs compiled into the engine. `make malachi-check REACH=1` proves a
# container reaches them.
WIKI_API_URL=
POP_STATS_URL=

# Blank until the deployed ref stops offering the SPA's `/#/p/<id>` links (README.md).
WEB_PUBLIC_URL=

# False until a page serves `/#/p/<id>/upload`: `project_context` offers that link. Web and
# tools both read this.
UPLOADS_ENABLED=false

# The tool server's limits. Blank is off. Set transcriptions at 5 or above: person_read
# transcribes five memories at a time.
GENEALOGY_FS_CALLS_PER_MINUTE=
GENEALOGY_MAX_TRANSCRIPTIONS=

# The key `make malachi-openrouter EMAIL=` encrypts onto that user's row. No service sees it.
OPENROUTER_SEED_KEY=

POSTGRES_PASSWORD=
DML_PASSWORD=
MINIO_ROOT_PASSWORD=
SESSION_SECRET=
FS_TOKEN_ENC_KEY=
