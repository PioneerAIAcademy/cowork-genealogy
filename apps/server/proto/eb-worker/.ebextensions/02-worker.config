# The worker tier's runtime settings (U12; handoff step 10). 01-sqsd.config owns the sqsd
# block and the values the worker reads from it; no option here is also set there.
# Secrets, PG_DSN, QUEUE_URL and MODEL_PROVIDER are API-level settings, never the bundle's.
option_settings:
  aws:elasticbeanstalk:application:environment:
    # The Procfile takes no arguments: worker.py reads PORT (code default 8080), and 8000
    # is the Python platform's default nginx upstream.
    PORT: "8000"
    # Where .platform/hooks/predeploy/01-worker-layout.sh puts the plugin, root-owned.
    ENGINE_PLUGIN_DIR: "/opt/genealogy/plugin"
    # The empty cwd anchor, created 0555 by the same hook.
    WORKER_CWD: "/project"
    # AL2023's /tmp is a tmpfs recreated every boot; the hook fails the deploy otherwise.
    TMPDIR: "/tmp"
    # U3: the slot users the hook creates, one per sqsd HttpConnections (2); each turn's CLI
    # runs as one. Space-separated: an environment value may not hold a comma.
    WORKER_TURN_USERS: "genealogy-turn-0 genealogy-turn-1"
    # libpq reads both; a DSN query string is outside the environment-value character set.
    PGSSLMODE: "verify-full"
    PGSSLROOTCERT: "/var/app/current/certs/rds-global-bundle.pem"
  # One instance until U6 (handoff step 13); an API-level setting overrides it.
  aws:autoscaling:asg:
    MinSize: "1"
    MaxSize: "1"
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: "true"
    DeleteOnTerminate: "false"
