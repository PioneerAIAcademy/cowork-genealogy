# The worker tier's interim sqsd settings (U5; handoff step 11), until U26's deadline.
# sqsd cuts only a run past 10 h. Why each value: docs/plan/u5-interim-sqsd.md, D1.
# The environment block tells the worker the same numbers for its last-receive close and
# its dead-letter sweep; test_proto_config.py pins each equal to its sqsd option.
option_settings:
  aws:elasticbeanstalk:sqsd:
    HttpPath: "/turn"
    HttpConnections: "2"
    # Beanstalk's documented maximum.
    InactivityTimeout: "36000"
    # InactivityTimeout + 300; SQS's maximum is 43200.
    VisibilityTimeout: "36300"
    MaxRetries: "5"
    # Above the worker's stop grace, a deploy window and a Postgres failover.
    ErrorVisibilityTimeout: "300"
    # The AWS default, written down because the sweep's backstop reads it.
    RetentionPeriod: "345600"
  aws:elasticbeanstalk:application:environment:
    SQSD_MAX_RETRIES: "5"
    SQSD_VISIBILITY_TIMEOUT_S: "36300"
    SQSD_RETENTION_PERIOD_S: "345600"
    SWEEP_INTERVAL_S: "300"
