# The ALB idle timeout for a tool call of up to 1800 s (handoff step 9), in a file of its
# own: a validation error drops the whole file, and a SingleInstance environment has no
# load balancer for this namespace (U13 measures whether it is ignored or rejected).
# Needs an ALB: LoadBalancerType=application must be passed to create-environment (README).
option_settings:
  aws:elbv2:loadbalancer:
    IdleTimeout: "1800"
