# The tools tier's settings (U12; handoff step 9). GENEALOGY_PG_DSN, GENEALOGY_S3_* and the
# config overrides (WIKI_API_URL, OPENROUTER_API_KEY, ...) are API-level settings, never
# the bundle's.
option_settings:
  aws:elasticbeanstalk:application:environment:
    # Equal to the Procfile's --port; setting PORT points the platform's nginx at it.
    PORT: "8080"
    # node-postgres reads PGSSLMODE when the DSN carries no sslmode; Node's TLS stack adds
    # the RDS CA from NODE_EXTRA_CA_CERTS. A DSN query string is outside the
    # environment-value character set.
    PGSSLMODE: "verify-full"
    NODE_EXTRA_CA_CERTS: "/var/app/current/certs/rds-global-bundle.pem"
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: "/healthz"
  # One instance until U6 (handoff step 13); an API-level setting overrides it.
  aws:autoscaling:asg:
    MinSize: "1"
    MaxSize: "1"
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: "true"
    DeleteOnTerminate: "false"
