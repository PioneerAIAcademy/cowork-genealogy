# The Classic load balancer's idle timeout for a tool call of up to 1800 s (handoff step 9),
# in a file of its own like 02-tools-alb.config. FamilySearch's Blueprint provisioner creates
# load-balanced environments with a Classic load balancer at 60 s (F12, F14; 2026-10-24),
# where 02-tools-alb.config's namespace is ignored. Each file is ignored on the other
# type: Beanstalk validated both options against a Classic environment without a message.
option_settings:
  aws:elb:policies:
    ConnectionSettingIdleTimeout: "1800"
