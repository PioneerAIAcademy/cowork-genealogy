# The Classic load balancer's idle timeout, in a file of its own like the tools tier's
# 03-tools-classic-elb.config (a validation error drops a whole file). FamilySearch's Blueprint
# provisioner creates load-balanced environments with a Classic load balancer at 60 s (handoff
# F12, F14; 2026-10-24). With TOOLS_UPSTREAM_URL set, /mcp reaches the tools tier through this
# load balancer, and a tool call runs up to 1800 s (handoff step 9); the project download is
# also built before its first byte. Ignored on an Application Load Balancer.
option_settings:
  aws:elb:policies:
    ConnectionSettingIdleTimeout: "1800"
