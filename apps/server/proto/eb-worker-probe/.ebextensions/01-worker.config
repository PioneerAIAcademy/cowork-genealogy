# Worker-tier settings for the probe. Values set here are the bundle's declared
# configuration; anything deploy.sh also passes to create/update-environment
# (the sqsd block) is overridden by that API-level value -- see README.md,
# "Precedence". SLEEP_S and the CloudWatch block are set only here.
option_settings:
  aws:elasticbeanstalk:sqsd:
    HttpPath: "/"
    HttpConnections: "2"
    InactivityTimeout: "1800"
    VisibilityTimeout: "2100"
    MaxRetries: "10"
  aws:elasticbeanstalk:application:environment:
    SLEEP_S: "1500"
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: "true"
    DeleteOnTerminate: "true"
    RetentionInDays: "7"
