{
  "name": "cowork-genealogy-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo: genealogy engine (mcp-server + plugin), shared viewer-ui + schema, Electron viewer, and the hosted web workbench (web client + FastAPI control plane).",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "node scripts/drop-npm-managed-trees.mjs --as-preinstall",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:web": "pnpm --filter web dev",
    "dev:electron": "pnpm --filter @genealogy/electron dev",
    "server": "bash apps/server/run-dev.sh"
  },
  "devDependencies": {
    "turbo": "^2.10.7",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "form-data@<4.0.6": "^4.0.6",
      "postcss@<8.5.25": "^8.5.25",
      "sharp@<0.35.4": "^0.35.4",
      "react-textarea-autosize@<8.5.9": "8.5.9"
    }
  }
}
